# =============================================================================
# Agent Platform — 环境变量配置
#
# 将此文件复制为 .env 并按需修改。所有配置项均有默认值，
# 不设置也能运行（开发模式）。
# =============================================================================

# ── 应用 ──────────────────────────────────────────────────────────────────────
APP_NAME=Agent Platform
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=9000

# ── CORS（逗号分隔） ───────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── 数据库 ────────────────────────────────────────────────────────────────────
# 留空则使用本地 SQLite（零配置开发）
# PostgreSQL 示例: postgresql+asyncpg://user:pass@localhost:5432/agent_platform
DATABASE_URL=
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE=3600

# ── JWT / 常规登录 ────────────────────────────────────────────────────────────
JWT_SECRET_KEY=agent-platform-dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7
ENABLE_PASSWORD_LOGIN=true
ENABLE_REGISTER=true
SEED_DEFAULT_ADMIN=true

# ── OAuth2.0 密码模式委托 ────────────────────────────────────────────────────
# 配置 OAUTH_AUTH_SERVER_URL 后，/auth/token 端点会先尝试向外部鉴权服务
# 发起 grant_type=password 请求验证用户身份，验证通过后同步用户到本地
# 并签发本地 JWT。留空则仅使用本地 bcrypt 密码校验。
OAUTH_AUTH_SERVER_URL=
OAUTH_CLIENT_ID=agent-platform
OAUTH_CLIENT_SECRET=
OAUTH_SCOPES=openid profile email
OAUTH_TOKEN_PATH=/oauth2/token
OAUTH_USERINFO_URL=
OAUTH_TOKEN_CACHE_TTL=300

# ── AgentScope / 模型 ────────────────────────────────────────────────────────
MODEL_API_KEY=
MODEL_API_BASE=https://api.openai.com/v1
MODEL_NAME=gpt-4o

# ── 沙盒 ────────────────────────────────────────────────────────────────────
# disabled | local | docker | k8s
SANDBOX_BACKEND=local

# ── 日志 ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=DEBUG
